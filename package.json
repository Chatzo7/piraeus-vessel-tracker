{
  "name": "piraeus-vessel-tracker",
  "version": "0.1.0",
  "description": "Live vessel map and port-call statistics for the Port of Piraeus, built on public AIS data.",
  "main": "src/index.js",
  "type": "commonjs",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/index.js",
    "demo": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/index.js --demo",
    "test": "node --disable-warning=ExperimentalWarning --test"
  },
  "keywords": ["ais", "maritime", "shipping", "piraeus", "leaflet", "nodejs", "sqlite"],
  "author": "Nikos Chatzopoulos",
  "license": "MIT"
}
